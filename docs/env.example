# .env.example — Psico-RAG PoC

# --- OpenAI (para embeddings da coleção pública) ---
OPENAI_API_KEY=sk-xxxxx

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=literatura
QDRANT_NOTES_COLLECTION=prontuario_privado
QDRANT_API_KEY=   # se usar Qdrant Cloud, insira aqui; local pode deixar vazio

# --- Modelos de embedding ---
EMBEDDING_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Embedding local para prontuário (coleção privada)
NOTES_EMBED_MODEL=BAAI/bge-m3
NOTES_EMBED_DIM=1024

# --- Ingestão híbrida (custos/limites) ---
MAX_TOKENS_ABSTRACT=1200
MAX_CHUNK_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# --- Caminhos locais de artefatos ---
FEATURES_PATH=data/processed/features.parquet
MODEL_PATH=models/baseline.joblib

# --- Outras configs (opcionais) ---
# PORT=8000
# HOST=0.0.0.0
